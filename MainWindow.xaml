<Window x:Class="BtFiller2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BT RF 测试报告生成工具" Height="280" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" FontFamily="Microsoft YaHei UI" FontSize="13">
       
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#333350"/>
                                <Setter Property="Foreground" Value="#555575"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="◈" Foreground="#7C6AF7" FontSize="22"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BT RF 测试报告生成工具"
                           Foreground="#E8E8F0" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="导入 CMWrun XML，自动生成 BT 传导测试报告"
                           Foreground="#606080" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 1: Select XML -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Border Background="#252535" CornerRadius="6" Padding="12,0">
                <TextBlock x:Name="TbXml" Foreground="#C0C0E0"
                           VerticalAlignment="Center" Height="38"
                           TextTrimming="CharacterEllipsis"
                           Text="① 点击右侧按钮选择 XML 文件…"/>
            </Border>
            <Button Grid.Column="2" Content="选择 XML"
                    Style="{StaticResource Btn}"
                    Background="#4A4A6A" Padding="0"
                    Click="BtnXml_Click"/>
        </Grid>

        <!-- Step 2: Generate -->
        <Button Grid.Row="4" x:Name="BtnGen"
                Content="② 生成 Excel 报告"
                IsEnabled="False"
                Style="{StaticResource Btn}"
                Background="#7C6AF7"
                FontSize="14" FontWeight="Bold" Height="46"
                Click="BtnGen_Click"/>

        <!-- Status bar -->
        <Border Grid.Row="6" Background="#252535" CornerRadius="6" Padding="14,10">
            <TextBlock x:Name="TbStatus"
                       Foreground="#7070A0" FontSize="11.5"
                       TextWrapping="Wrap"
                       Text="请选择 XML 文件后点击生成。"/>
        </Border>
    </Grid>
</Window>
